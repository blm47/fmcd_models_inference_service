flowchart TB
    H[("Hadoop")]
    subgraph AF["Airflow — отдельный DAG для каждой модели"]
        E["Подготовка данных<br/>Hadoop → S3"]
        OP["Кастомный оператор<br/>Запуск и ожидание расчёта"]
        R["После DONE<br/>S3 → Hadoop"]
        E --> OP --> R
    end
    IN[("Входные данные S3")]
    OUT[("Результаты S3")]
    H --> E --> IN
    OUT --> R --> H

    subgraph K["Kubernetes — сервис инференса"]
        API["API через балансировщик<br/>Приём заявок, статус, отмена"]
        Q[("Общая очередь в S3<br/>Задачи и их статусы")]
        P1["Под 1<br/>Один GPU worker"]
        P2["Под 2<br/>Один GPU worker"]
        M["Монитор на каждом поде<br/>Проверка таймаутов"]
        API <--> Q
        Q -->|"Задачу берёт свободный под"| P1
        Q --> P2
        P1 & P2 -->|"Прогресс и heartbeat"| Q
        M <--> Q
    end
    OP <-->|"Запуск и проверка статуса"| API
    IN --> P1 & P2
    P1 & P2 --> OUT
